# Database
#TYPEORM_HOST=db
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_DATABASE=invoice
TYPEORM_USERNAME=invoice
TYPEORM_PASSWORD=example_password


# Auth (next-auth)
AUTH_SECRET=change-me-to-a-random-32-char-string

# Admin seed credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# LLM adapter
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=your-litellm-api-key
LLM_MODEL=amazon.nova-lite-v1:0

# File storage root (mapped to EBS volume in prod)
DATA_DIR=/data


