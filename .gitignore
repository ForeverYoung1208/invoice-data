# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# docker volume data (mapped to EBS on EC2)
docker/app-files/data
!docker/app-files/.gitkeep
docker/postgres/data
!docker/postgres/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI configs
.kilo/