{
  "name": "invoice-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:e2e": "playwright test",
    "app:dev": "next dev --webpack --hostname 0.0.0.0",
    "worker:dev": "tsx watch worker/worker.ts",
    "build": "next build",
    "start": "concurrently \"next start\" \"npm run worker:prod\"",
    "worker:prod": "tsx worker/worker.ts",
    "lint": "eslint \"{src,app,test,worker}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,app,test,worker}/**/*.ts\" --max-warnings=0",
    "typeorm": "node -r ts-node/register ./node_modules/typeorm/cli.js -d ./src/lib/db/dataSource.ts",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:generate": "npm run typeorm migration:generate src/lib/db/migrations/$npm_config_name",
    "migration:create": "typeorm migration:create src/lib/db/migrations/$npm_config_name",
    "db:seed": "tsx src/lib/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@langchain/core": "^1.1.41",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.4.4",
    "@tanstack/react-query": "^5.100.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.1",
    "dayjs": "^1.11.21",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "formidable": "^3.5.4",
    "lucide-react": "^1.9.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "next-swagger-doc": "^0.4.1",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "shadcn": "^4.4.0",
    "swagger-ui-react": "^5.32.4",
    "tailwind-merge": "^3.5.0",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^0.3.28",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/formidable": "^3.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "jest": "^30.4.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}